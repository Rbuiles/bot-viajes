# Travelpayouts
TRAVELPAYOUTS_TOKEN=tu_token_aqui
TRAVELPAYOUTS_MARKER=tu_marker_aqui
# true = solo ida y vuelta; false = acepta solo ida e ida y vuelta
ONLY_ROUND_TRIP=false

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_ACCESS_TOKEN=tu_access_token
NOTIFICATION_PHONE=+573001234567

# Planificación y anti-duplicados
CHECK_INTERVAL_MINUTES=5
DEDUPLICATION_HOURS=48
NOTIFICATION_RETENTION_DAYS=30

# Umbrales de Súper Promoción en USD (editables)
THRESHOLD_SOUTH_AMERICA_NEAR_USD=200
THRESHOLD_SOUTH_AMERICA_FAR_USD=300
THRESHOLD_CENTRAL_AMERICA_CARIBBEAN_USD=220
THRESHOLD_EUROPE_USD=550
THRESHOLD_ASIA_USD=950

# Opciones avanzadas
# DATABASE_URL=sqlite+aiosqlite:///./data/flight_alerts.db
